// ─────────────────────────────────────────────
// Market Model
// ─────────────────────────────────────────────

model Market {
  id        String   @id @default(uuid())
  name      String
  city      String?
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]
  users   User[]

  @@map("markets")
}
