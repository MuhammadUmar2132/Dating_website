// ─────────────────────────────────────────────
// Calendar Event Model
// ─────────────────────────────────────────────

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  type        EventType @default(OTHER)
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("calendar_events")
}
