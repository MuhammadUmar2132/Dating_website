// ─────────────────────────────────────────────
// Competition Model
// ─────────────────────────────────────────────

model Competition {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  status             CompetitionStatus @default(DRAFT)
  startDate          DateTime
  endDate            DateTime
  gracePeriodEndDate DateTime?
  isExtended         Boolean           @default(false)
  scoringOpen        Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("competitions")
}
